<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ing</groupId>
        <artifactId>ingenious-playwright</artifactId>
        <version>4.0.0</version>
    </parent>
    <artifactId>Dist</artifactId>
    <packaging>pom</packaging>
    <build>
        <finalName>${project.parent.artifactId}-${project.parent.version}</finalName>
        <plugins>           
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>clean-setupDir</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${setupDir}</directory>
                                    <followSymlinks>false</followSymlinks>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                    <execution>
                        <id>purge-stale-setupDir</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${setupDir}</directory>
                                    <followSymlinks>false</followSymlinks>
                                    <includes>
                                        <include>ingenious-ide-*.jar</include>
                                        <include>Engine/lib/ingenious-datalib-*.jar</include>
                                        <include>Engine/lib/ingenious-testdata-csv-*.jar</include>
                                        <include>lib/ingenious-datalib-*.jar</include>
                                        <include>lib/ingenious-testdata-*.jar</include>
                                        <include>lib/ingenious-engine-*.jar</include>
                                        <include>Tools/storywriter-*.jar</include>
                                        <include>tools/**</include>
                                    </includes>
                                    <!--
                                      Die laufende Version ausnehmen, sonst reisst dieser Schritt
                                      ein Loch: lib/ingenious-datalib und lib/ingenious-testdata-csv
                                      werden von IDE/pom.xml copy-dependencies in prepare-package
                                      gelegt (dasselbe Phase, IDE laeuft vorher), aber Dist
                                      copy-jar legt sie in package nur nach Engine/lib zurueck.
                                      Geloescht und nie ersetzt startete Studio nicht mehr:
                                      NoClassDefFoundError com/ing/datalib/testdata/TestDataFactory,
                                      gemessen am 27.08.2026 (194 statt 196 JARs in lib/).
                                      Alte Versionen fallen weiterhin, die aktuelle bleibt.
                                    -->
                                    <excludes>
                                        <exclude>ingenious-ide-${project.parent.version}.jar</exclude>
                                        <exclude>Engine/lib/ingenious-datalib-${project.parent.version}.jar</exclude>
                                        <exclude>Engine/lib/ingenious-testdata-csv-${project.parent.version}.jar</exclude>
                                        <exclude>lib/ingenious-datalib-${project.parent.version}.jar</exclude>
                                        <exclude>lib/ingenious-testdata-csv-${project.parent.version}.jar</exclude>
                                        <exclude>lib/ingenious-engine-${project.parent.version}.jar</exclude>
                                        <exclude>Tools/storywriter-${project.parent.version}.jar</exclude>
                                    </excludes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
				<version>3.9.0</version>
                <executions>       
                    <execution>
                        <id>copy-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.parent.groupId}</groupId>
                                    <artifactId>ingenious-ide</artifactId>
                                    <version>${project.parent.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>                                    
                                    <outputDirectory>${setupDir}</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>${project.parent.groupId}</groupId>
                                    <artifactId>storywriter</artifactId>
                                    <version>${project.parent.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>                                    
                                    <outputDirectory>${setupDir}/Tools</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>${project.parent.groupId}</groupId>
                                    <artifactId>ingenious-datalib</artifactId>
                                    <version>${project.parent.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${setupDir}/Engine/lib</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>${project.parent.groupId}</groupId>
                                    <artifactId>ingenious-testdata-csv</artifactId>
                                    <version>${project.parent.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${setupDir}/Engine/lib</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>${project.parent.groupId}</groupId>
                                    <artifactId>ingenious-engine</artifactId>
                                    <version>${project.parent.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${setupDir}/lib</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.ing</groupId>
                                    <artifactId>ingenious-api</artifactId>
                                    <version>${ingenious-api.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${setupDir}/Engine/lib</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.ing</groupId>
                                    <artifactId>ingenious-api</artifactId>
                                    <version>${ingenious-api.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${setupDir}/lib</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>                    
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>assembly_zip.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>create-archive</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.0.2</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <!-- Was install: assembly runs in package, so a fresh clone's
                             mvn clean package packed an empty Dist/release (issue #300). -->
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${setupDir}</outputDirectory>
                            <includeEmptyDirs>true</includeEmptyDirs>
                            <resources>
                                <resource>
                                    <directory>${resourceDir}</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>**/*.bat</include>
                                        <include>**/*.command</include>
                                        <include>**/*.txt</include>
                                        <include>**/*.md</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${resourceDir}</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>**/*.bat</exclude>
                                        <exclude>**/*.command</exclude>
                                        <exclude>**/*.txt</exclude>
                                        <exclude>**/*.md</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-qa-tools</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${setupDir}/tools</outputDirectory>
                            <includeEmptyDirs>true</includeEmptyDirs>
                            <resources>
                                <resource>
                                    <directory>../../tools</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>remote/**</exclude>
                                        <exclude>fixtures/**</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Set executable permission on ingenious.command after copy (macOS/Linux only) -->
        <profile>
            <id>unix-permissions</id>
            <activation>
                <os>
                    <family>!windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>set-executable-permission</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <chmod file="${setupDir}/ingenious.command" perm="755"/>
                                        <chmod file="${setupDir}/ingenious" perm="755"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Optional npm install - activate with -Pnpm-install when needed -->
        <profile>
            <id>npm-install</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>npm-install</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>npm</executable>
                                    <arguments>
                                        <argument>install</argument>
                                    </arguments>
                                    <workingDirectory>${setupDir}</workingDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>